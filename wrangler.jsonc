// Cloudflare Worker 설정 — 방문자용 읽기 전용 사이트 (규약: worker/CONTRACT.md)
// 비밀은 여기 쓰지 않는다: npx wrangler secret put PUBLISH_TOKEN / ADULT_PASSWORD / SESSION_SECRET
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simsimhae",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* 만 Worker 가 받고, 나머지(화면 파일)는 Worker 를 거치지 않고 바로 나간다 (요청 수 절약)
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simsimhae",
      // 첫 GitHub 자동 배포 때 만들어진 D1. 다른 계정에 새로 배포하려면 이 줄을 지우면 같은 이름으로 다시 만들어 연결한다.
      // 로컬 시험(wrangler dev --local)은 이 id 와 상관없이 이 컴퓨터 안의 D1 으로 돈다.
      "database_id": "b2a1c9f1-c712-4a35-b5f9-cfc9ef3bdc53"
    }
  ]
}
