{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simsimhae",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VOTES", "class_name": "VotesDO" }]
  },
  // v1 은 예전 사이트의 저장소 클래스(SiteDO) — 데이터를 지우지 않으려고 클래스 이름은 남겨 둔다.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SiteDO"] },
    { "tag": "v2", "new_sqlite_classes": ["VotesDO"] }
  ],
  "observability": { "enabled": true }
}
