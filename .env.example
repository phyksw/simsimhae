# 이 파일을 .env 로 복사해서 쓰세요. (모두 선택 사항)

# 사이트 이름 / 포트 / 바인딩 주소 (외부에서 접속하게 하려면 HOST=0.0.0.0)
SITE_NAME=심심풀이
PORT=3000
HOST=127.0.0.1

# 비밀번호 — 비워두면 처음 실행할 때 data/secrets.json 에 무작위로 만들어져요
# (콘솔에는 secrets.json 을 처음 만든 실행에만 보여줘요. 바꾸고 다시 시작하면 기존 로그인은 풀려요)
ADULT_PASSWORD=
ADMIN_PASSWORD=

# 리버스 프록시 뒤에서 돌릴 때 믿을 프록시 (express 'trust proxy' 값). 기본 loopback = 같은 컴퓨터의 프록시.
# 도커·NAS 등 다른 주소의 프록시면 예: TRUST_PROXY=loopback,172.16.0.0/12
TRUST_PROXY=loopback
# 인증 쿠키 Secure 속성: 비우면 HTTPS 요청일 때만, 1 이면 항상, 0 이면 붙이지 않음
COOKIE_SECURE=

# 이미지/영상 프록시 남용 방지: 접속자당 분당 요청 수, 서버 전체·접속자당 동시 연결 수, 응답 하나의 최대 크기(바이트)
IMG_RATE_PER_MIN=600
IMG_MAX_CONCURRENT=64
IMG_MAX_CONCURRENT_PER_IP=16
IMG_MAX_BYTES=83886080

# Claude 검수 — 키를 넣으면 자동으로 켜져요 (AI_MODERATION=0 으로 끌 수 있어요)
ANTHROPIC_API_KEY=
# 기본 claude-opus-5-5. 비용을 줄이려면 claude-haiku-5-5 (훨씬 저렴, 판정은 조금 덜 섬세)
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# 수집 1회에 Claude 에 보내는 최대 글 수 / 판정 실패한 글을 다시 보내는 최대 횟수 (그 뒤로는 키워드 판정만)
AI_MAX_PER_RUN=200
AI_MAX_TRIES=6

# 수집 (실시간 ON/OFF·간격은 관리자 화면에서도 바꿀 수 있어요)
CRAWL_INTERVAL_MIN=15
PAGES_PER_SOURCE=2
RETENTION_DAYS=14
# 특정 소스만 쓰기 / 빼기 (쉼표로 구분, 예: dogdrip,quasarzone)
SOURCES=
DISABLE_SOURCES=
# 같은 사이트에 보내는 요청 사이의 최소 간격(ms)
CRAWL_MIN_INTERVAL_MS=1200

# 공개 사이트(Cloudflare Worker)로 올리기 — 주소·토큰이 둘 다 있어야 켜져요 (README 의 "공개 사이트")
# 주소: https://simsimhae.<workers.dev 서브도메인>.workers.dev  (서브도메인을 board 로 바꿨다면 https://simsimhae.board.workers.dev)
PUBLISH_URL=
# Worker 비밀 PUBLISH_TOKEN 과 같은 값 (긴 무작위 문자열)
PUBLISH_TOKEN=
# 한 번에 새로 만들어 올리는 미리보기 수 (출처 사이트 부담을 생각해 너무 크게 하지 마세요. 0 이면 목록만)
PUBLISH_READ_LIMIT=40
# 관리자 변경 뒤 이 시간(초) 안에 한 번 올려요
PUBLISH_DEBOUNCE_SEC=30
